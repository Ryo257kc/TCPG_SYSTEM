root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[compose.yaml]
indent_size = 4

[*.{png,jpg,jpeg,gif,ico,pdf,zip}]
insert_final_newline = false
trim_trailing_whitespace = false
