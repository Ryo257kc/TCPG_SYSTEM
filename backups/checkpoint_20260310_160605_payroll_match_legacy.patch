+    private function shouldApplyKaigoInsuranceForMonth(string $staffId, ?string $payrollDate): bool
+    {
+        // Strict rule: if month/birthday cannot be resolved, do not apply kaigo.
+        $targetTs = strtotime((string) $payrollDate);
+        if ($targetTs === false) {
+            return false;
+        }
+
+        $birthday = $this->resolveStaffBirthday($staffId);
+        if ($birthday === null) {
+            return false;
+        }
+
+        $birthTs = strtotime($birthday);
+        if ($birthTs === false) {
+            return false;
+        }
+
+        // Start from the month that includes the day before 40th birthday
+        // => practically the month of 40th birthday.
+        $startTs = strtotime('+40 years', $birthTs);
+        if ($startTs === false) {
+            return false;
+        }
+
+        $startMonth = date('Y-m-01', $startTs);
+        $targetMonth = date('Y-m-01', $targetTs);
+        return $targetMonth >= $startMonth;
+    }
