+    private function resolveStaffBirthday(string $staffId): ?string
+    {
+        $staffId = trim($staffId);
+        if ($staffId === '') {
+            return null;
+        }
+
+        $staffIdNoZero = ltrim($staffId, '0');
+        if ($staffIdNoZero === '') {
+            $staffIdNoZero = '0';
+        }
+
+        try {
+            $row = DB::connection('sqlsrv')
+                ->table('dbo.m_staffs')
+                ->where(function ($q) use ($staffId, $staffIdNoZero) {
+                    $q->whereRaw('LTRIM(RTRIM(staff_code)) = ?', [$staffId])
+                        ->orWhereRaw('LTRIM(RTRIM(staff_code)) = ?', [$staffIdNoZero])
+                        ->orWhereRaw('TRY_CONVERT(int, staff_code) = TRY_CONVERT(int, ?)', [$staffId]);
+                })
+                ->first(['birthday', 'birth_date', 'date_of_birth', 'birth_day']);
+
+            if ($row === null) {
+                return null;
+            }
+
+            foreach (['birthday', 'birth_date', 'date_of_birth'] as $col) {
+                $raw = trim((string) ($row->{$col} ?? ''));
+                if ($raw === '') {
+                    continue;
+                }
+                $ts = strtotime($raw);
+                if ($ts !== false) {
+                    return date('Y-m-d', $ts);
+                }
+            }
+        } catch (\Throwable) {
+            // fallback below
+        }
+
+        // Fallback to legacy staff table when m_staffs is missing birthday.
+        try {
+            $row = DB::connection('sqlsrv')
+                ->table('dbo.staff')
+                ->where(function ($q) use ($staffId, $staffIdNoZero) {
+                    $q->whereRaw('LTRIM(RTRIM(staff_id)) = ?', [$staffId])
+                        ->orWhereRaw('LTRIM(RTRIM(staff_id)) = ?', [$staffIdNoZero])
+                        ->orWhereRaw('TRY_CONVERT(int, staff_id) = TRY_CONVERT(int, ?)', [$staffId]);
+                })
+                ->first(['birthday', 'birth_date', 'date_of_birth', 'birth_day']);
+
+            if ($row !== null) {
+                foreach (['birthday', 'birth_date', 'date_of_birth', 'birth_day'] as $col) {
+                    $raw = trim((string) ($row->{$col} ?? ''));
+                    if ($raw === '') {
+                        continue;
+                    }
+                    $ts = strtotime($raw);
+                    if ($ts !== false) {
+                        return date('Y-m-d', $ts);
+                    }
+                }
+            }
+        } catch (\Throwable) {
+            return null;
+        }
+
+        return null;
+    }
